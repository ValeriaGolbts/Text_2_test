# КОНФИГУРАЦИЯ GIGACHAT API
# Обязательные параметры
GIGACHAT_API_KEY=gigachat_api_key # Ключ от GigaChat API

# Базовые настройки API
GIGACHAT_MODEL=GigaChat-2-Max    # Используемая модель
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1  # URL API
GIGACHAT_TIMEOUT=60             # Таймаут запроса в секундах

# Параметры генерации
GIGACHAT_MAX_TOKENS=4000        # Максимальное количество токенов в ответе
GIGACHAT_TEMPERATURE=0.7        # Креативность (0-1)

# НАСТРОЙКИ ГЕНЕРАТОРА ТЕСТОВ
# Количество вопросов по умолчанию
DEFAULT_QUESTIONS_COUNT=10

# Сложность по умолчанию
DEFAULT_DIFFICULTY=medium  # easy, medium, hard

# НАСТРОЙКИ ПРОЕКТА
# Режим отладки
DEBUG=true  # true/false

# Максимальный размер текста для обработки (символов)
MAX_TEXT_LENGTH=10000

# Формат вывода теста
OUTPUT_FORMAT=json  # json, markdown, html
