# ====================================
# GIGACHAT API CONFIGURATION
# ====================================
# Получите ключ на: https://developers.sber.ru/studio
GIGACHAT_API_KEY=your_gigachat_api_key_here

# Модель GigaChat (GigaChat, GigaChat-Pro)
GIGACHAT_MODEL=GigaChat

# Параметры генерации
GIGACHAT_TEMPERATURE=0.7
GIGACHAT_MAX_TOKENS=2000
GIGACHAT_TOP_P=0.9

# ====================================
# APPLICATION SETTINGS
# ====================================
DEBUG=True
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ====================================
# PROCESSING SETTINGS
# ====================================
CHUNK_SIZE=2000
MAX_QUESTIONS=20
DEFAULT_DIFFICULTY=medium

# ====================================
# TELEGRAM BOT (для будущего модуля)
# ====================================
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_ADMIN_IDS=123456789
